{
  "name": "medix-workshop",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,css,md}\"",
    "db:seed": "pnpm --filter ./apps/api db:seed",
    "test": "turbo test",
    "test:all": "pnpm test && pnpm e2e",
    "e2e": "pnpm --filter ./apps/e2e e2e"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "0.2.3",
    "@types/node": "25.6.0",
    "prettier": "3.8.3",
    "turbo": "2.9.9",
    "typescript": "6.0.3"
  },
  "overrides": {
    "postcss": "8.5.14",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
